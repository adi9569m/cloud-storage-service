# ==========================================
# Cloud Storage Service - Environment Config
# ==========================================

# Application Settings
APP_NAME=CloudStorageService
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL
# For SQLite (instant local zero-config run):
DATABASE_URL=sqlite:///./cloud_storage.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cloud_storage

# JWT Security
JWT_SECRET_KEY=dev-secret-key-change-in-production-must-be-long-and-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage (Optional for production cloud bucket)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=cloud-storage-bucket

# Storage Quotas & Limits
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
MAX_BATCH_OPERATION_ITEMS=100
MAX_ZIP_DOWNLOAD_BYTES=1073741824
MAX_PREVIEW_TEXT_BYTES=1048576

# Maintenance & Rate Limiting
AUTO_TRASH_PURGE_DAYS=30
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
