# ==============================================================================
# Cloud Storage Service - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Application Settings
APP_NAME=CloudStorageService
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (Supabase PostgreSQL or local PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:your-postgres-password@db.your-supabase-project.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage & Services
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=cloud-storage-bucket
